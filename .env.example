# Copy to .env.local and fill in values.
# Local: npx supabase status
# Production: Supabase dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres URL for Drizzle (local: npx supabase status → DB URL)
# On Vercel, use the pooled connection string (port 6543), not the direct one.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
